rules_version = '2';

/* =====================================================================
   Tech Verse — Firestore Security Rules (শুধুমাত্র এই প্রজেক্টের জন্য)

   ▸ আইসোলেশন: সব ডেটা /tvProject/main/** নেমস্পেসের ভেতরে। অন্য কোনো অ্যাপ/কোর্স/এক্সাম/
     ফ্ল্যাশকার্ড/Learning Hub-এর কালেকশন বা rule এখানে নেই। নেমস্পেসের বাইরের সবকিছু
     ফাইলের শেষের default-deny-তে আটকায়।
   ▸ অ্যাডমিন: tvProject/main/users/{uid}.isAdmin == true — শুধু এই প্রজেক্টের নিজস্ব users।
     ইউজার নিজের isAdmin/communityBlocked কখনো বদলাতে পারে না (শুধু অ্যাডমিন পারে)।
   ▸ কোনো global/open write নেই। প্রতিটা create/update-এ ফিল্ড whitelist + টাইপ + দৈর্ঘ্য +
     সার্ভার-টাইমস্ট্যাম্প যাচাই হয়।
   ▸ কমিউনিটি পড়া: সবাই (লগইন ছাড়াও) শুধু status == "active" কনটেন্ট পড়তে পারে।
     লিখতে/লাইক/রিপোর্ট করতে লগইন + ব্লক-না-হওয়া লাগে।
     (লগইন ছাড়া পড়া বন্ধ করতে চাইলে নিচের canReadContent()-এ isSignedIn() && যোগ করুন।)
   ===================================================================== */
service cloud.firestore {
  match /databases/{database}/documents {

    /* ---------------------------------------------------------------
       ১) সাধারণ হেল্পার
       --------------------------------------------------------------- */
    function isSignedIn() {
      return request.auth != null;
    }
    function profilePath(uid) {
      return /databases/$(database)/documents/tvProject/main/users/$(uid);
    }
    function hasProfile() {
      return isSignedIn() && exists(profilePath(request.auth.uid));
    }
    // কলারের নিজের (বিশ্বাসযোগ্য) প্রোফাইল ডকুমেন্ট
    function profile() {
      return get(profilePath(request.auth.uid)).data;
    }
    function isAdmin() {
      return hasProfile() && profile().get('isAdmin', false) == true;
    }
    function isBlocked() {
      return hasProfile() && profile().get('communityBlocked', false) == true;
    }
    // কমিউনিটিতে লেখার অনুমতি: প্রোফাইল আছে এবং অ্যাডমিন ব্লক করেননি
    function canPost() {
      return hasProfile() && !isBlocked();
    }
    function isStr(v, minLen, maxLen) {
      return v is string && v.size() >= minLen && v.size() <= maxLen;
    }
    function isDocId(v) {
      return v is string && v.matches('^[A-Za-z0-9]{1,40}$');
    }
    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    /* ---------------------------------------------------------------
       ২) প্রোফাইল ভ্যালিডেশন
       --------------------------------------------------------------- */
    // avatarThumb: খালি, ছোট data:image, অথবা Google/GitHub-এর অবতার লিংক — অন্য কোনো বাইরের URL নয়
    function validThumb(v) {
      return v is string && v.size() <= 12000 && (
        v == '' ||
        v.matches('^data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+$') ||
        v.matches('^https://(lh[0-9]+\\.googleusercontent\\.com|avatars\\.githubusercontent\\.com)/.*$')
      );
    }
    function validProfile(d) {
      return isStr(d.name, 0, 80)
        && isStr(d.email, 0, 200)
        && (!('photoURL' in d) || isStr(d.photoURL, 0, 500))
        && (!('phone' in d) || isStr(d.phone, 0, 30))
        && (!('bio' in d) || isStr(d.bio, 0, 500))
        && (!('avatarData' in d) || isStr(d.avatarData, 0, 150000))
        && (!('avatarThumb' in d) || validThumb(d.avatarThumb));
    }

    /* ---------------------------------------------------------------
       ৩) লাইক যাচাই — শুধু কলারের নিজের uid যোগ/বাদ, বাকি সব uid অপরিবর্তিত, সাইজ ঠিক ±১
       (সর্বোচ্চ ৫০০০ লাইক/ডকুমেন্ট — ডকুমেন্ট সাইজ সীমার নিরাপদ ভেতরে)
       --------------------------------------------------------------- */
    function isValidLikeToggle(oldList, newList) {
      let uid = request.auth.uid;
      return newList is list && oldList is list && (
        (uid in newList && !(uid in oldList) &&
          newList.size() == oldList.size() + 1 && newList.size() <= 5000 &&
          newList.hasAll(oldList)) ||
        (!(uid in newList) && uid in oldList &&
          newList.size() == oldList.size() - 1 &&
          oldList.hasAll(newList))
      );
    }

    /* ---------------------------------------------------------------
       ৪) কমিউনিটি পাথ ও পড়ার নিয়ম
       --------------------------------------------------------------- */
    function discPath(did) {
      return /databases/$(database)/documents/tvProject/main/discussions/$(did);
    }
    function replyPath(did, rid) {
      return /databases/$(database)/documents/tvProject/main/discussions/$(did)/replies/$(rid);
    }
    function categoryPath(cid) {
      return /databases/$(database)/documents/tvProject/main/categories/$(cid);
    }
    function isSlug(v) {
      return v is string && v.size() <= 40 && v.matches('^[a-z0-9]+(-[a-z0-9]+)*$');
    }
    function isActiveCategory(cid) {
      return isSlug(cid) && get(categoryPath(cid)).data.get('active', false) == true;
    }
    // active কনটেন্ট সবাই পড়বে; লুকানো/মুছে ফেলা কনটেন্ট শুধু মালিক ও অ্যাডমিন
    function canReadContent(d) {
      return d.status == 'active' || (isSignedIn() && d.uid == request.auth.uid) || isAdmin();
    }
    function isOwner() {
      return isSignedIn() && resource.data.uid == request.auth.uid;
    }

    /* ---------------------------------------------------------------
       ৫) রিপ্লাই-কাউন্ট সিঙ্ক (নকল কাউন্ট ঠেকানো)
       replyCount বদলাতে হলে একই batch-এ একটা রিপ্লাই তৈরি/নিষ্ক্রিয়/সক্রিয় হতে হবে এবং
       discussion-এ replySyncId = সেই রিপ্লাইয়ের id থাকতে হবে।
       --------------------------------------------------------------- */
    // রিপ্লাই-সাইড: batch শেষে parent-এর কাউন্ট ঠিক delta বদলেছে এবং replySyncId মিলেছে কিনা
    function parentCountDelta(did, rid, delta) {
      return getAfter(discPath(did)).data.replySyncId == rid
        && getAfter(discPath(did)).data.replyCount == get(discPath(did)).data.replyCount + delta;
    }
    // discussion-সাইড: কাউন্ট বদলের পেছনে সত্যিকারের রিপ্লাই লেখা আছে কিনা
    function isValidReplySync(did, oldD, newD) {
      let rid = newD.get('replySyncId', '');
      return isDocId(rid) && newD.replyCount is int && oldD.replyCount is int && (
        // (ক) নতুন রিপ্লাই: আগে ছিল না, এখন আছে, লেখক কলার নিজে, active
        (newD.replyCount == oldD.replyCount + 1 && oldD.status == 'active'
          && !exists(replyPath(did, rid)) && existsAfter(replyPath(did, rid))
          && getAfter(replyPath(did, rid)).data.uid == request.auth.uid
          && getAfter(replyPath(did, rid)).data.status == 'active') ||
        // (খ) রিপ্লাই মুছে/লুকিয়ে ফেলা: active ছিল, এখন active নয়
        (newD.replyCount == oldD.replyCount - 1 && oldD.replyCount > 0
          && exists(replyPath(did, rid)) && get(replyPath(did, rid)).data.status == 'active'
          && getAfter(replyPath(did, rid)).data.status != 'active') ||
        // (গ) অ্যাডমিন রিপ্লাই আবার সক্রিয় করা (অ্যাডমিন-ছাড়া কেউ রিপ্লাইয়ের status বদলাতে পারে না)
        (newD.replyCount == oldD.replyCount + 1
          && exists(replyPath(did, rid)) && get(replyPath(did, rid)).data.status != 'active'
          && getAfter(replyPath(did, rid)).data.status == 'active')
      );
    }
    function isValidReplyTo(did, d) {
      return (!('replyToId' in d) && !('replyToName' in d)) || (
        isDocId(d.replyToId) && isStr(d.replyToName, 0, 80)
        && get(replyPath(did, d.replyToId)).data.authorName == d.replyToName
      );
    }
    function isAdminReplyModeration(did, rid) {
      return isAdmin()
        && changed().hasOnly(['status', 'updatedAt', 'moderatedBy', 'moderatedAt'])
        && request.resource.data.status in ['active', 'hidden', 'deleted']
        && request.resource.data.moderatedBy == request.auth.uid
        && request.resource.data.moderatedAt == request.time
        && request.resource.data.updatedAt == request.time
        && (
          ((resource.data.status == 'active') == (request.resource.data.status == 'active')) ||
          (resource.data.status == 'active' && request.resource.data.status != 'active'
            && parentCountDelta(did, rid, -1)) ||
          (resource.data.status != 'active' && request.resource.data.status == 'active'
            && parentCountDelta(did, rid, 1))
        );
    }

    /* =================================================================
       ইউজার প্রোফাইল — tvProject/main/users/{uid}
       ================================================================= */
    match /tvProject/main/users/{uid} {
      allow get: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();

      // নতুন প্রোফাইল: নিজের uid, isAdmin অবশ্যই false, createdAt = সার্ভার সময়, শুধু whitelist ফিল্ড
      allow create: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'email', 'photoURL', 'phone', 'isAdmin', 'createdAt', 'avatarData', 'avatarThumb', 'bio'])
        && request.resource.data.keys().hasAll(['name', 'email', 'isAdmin', 'createdAt'])
        && request.resource.data.isAdmin == false
        && request.resource.data.createdAt == request.time
        && validProfile(request.resource.data);

      allow update: if isSignedIn() && (
        // মালিক: শুধু এই ফিল্ডগুলো — isAdmin/communityBlocked/createdAt/email কখনো নয়
        (request.auth.uid == uid
          && changed().hasOnly(['name', 'phone', 'bio', 'avatarData', 'avatarThumb'])
          && validProfile(request.resource.data)) ||
        // অ্যাডমিন: শুধু রোল ও কমিউনিটি-ব্লক
        (isAdmin()
          && changed().hasOnly(['isAdmin', 'communityBlocked'])
          && request.resource.data.isAdmin is bool
          && request.resource.data.get('communityBlocked', false) is bool)
      );

      allow delete: if false;
    }

    /* =================================================================
       বুকিং অনুরোধ — tvProject/main/bookings/{bookingId}
       ================================================================= */
    match /tvProject/main/bookings/{bookingId} {
      // যে কেউ (লগইন ছাড়াও) জমা দিতে পারবে — তবে কঠোর ভ্যালিডেশনসহ
      allow create: if
        request.resource.data.keys().hasOnly(['service', 'name', 'email', 'phone', 'budget', 'timeline', 'details', 'uid', 'status', 'createdAt']) &&
        request.resource.data.keys().hasAll(['service', 'name', 'email', 'createdAt']) &&
        (!('uid' in request.resource.data) ||
          request.resource.data.uid == null ||
          (isSignedIn() && request.resource.data.uid == request.auth.uid)) &&
        (!('status' in request.resource.data) || request.resource.data.status == 'নতুন') &&
        request.resource.data.createdAt == request.time &&
        isStr(request.resource.data.name, 1, 120) &&
        isStr(request.resource.data.email, 1, 200) &&
        request.resource.data.email.matches('^[^@]+@[^@]+\\.[^@]+$') &&
        isStr(request.resource.data.service, 1, 200) &&
        (!('phone' in request.resource.data) || isStr(request.resource.data.phone, 0, 30)) &&
        (!('budget' in request.resource.data) || isStr(request.resource.data.budget, 0, 100)) &&
        (!('timeline' in request.resource.data) || isStr(request.resource.data.timeline, 0, 100)) &&
        (!('details' in request.resource.data) || isStr(request.resource.data.details, 0, 3000));

      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());

      // অ্যাডমিন শুধু status বদলাতে পারবে (বৈধ মানের মধ্যে)
      allow update: if isAdmin()
        && changed().hasOnly(['status'])
        && request.resource.data.status in ['নতুন', 'যোগাযোগ করা হয়েছে', 'চলমান', 'সম্পন্ন', 'বাতিল'];
      allow delete: if isAdmin();
    }

    /* =================================================================
       সাইট সেটিংস — শুধু settings/site
       ================================================================= */
    match /tvProject/main/settings/{docId} {
      allow read: if docId == 'site';
      allow create, update: if isAdmin() && docId == 'site' && request.resource.data.keys().size() <= 40;
      allow delete: if false;
    }

    /* =================================================================
       সাইটের কন্টেন্ট (অ্যাডমিন প্যানেল থেকে ম্যানেজ) — পড়া সবার, লেখা শুধু অ্যাডমিন
       ================================================================= */
    match /tvProject/main/services/{id}     { allow read: if true; allow create, update: if isAdmin() && request.resource.data.keys().size() <= 30; allow delete: if isAdmin(); }
    match /tvProject/main/portfolio/{id}    { allow read: if true; allow create, update: if isAdmin() && request.resource.data.keys().size() <= 30; allow delete: if isAdmin(); }
    match /tvProject/main/caseStudies/{id}  { allow read: if true; allow create, update: if isAdmin() && request.resource.data.keys().size() <= 30; allow delete: if isAdmin(); }
    match /tvProject/main/testimonials/{id} { allow read: if true; allow create, update: if isAdmin() && request.resource.data.keys().size() <= 30; allow delete: if isAdmin(); }
    match /tvProject/main/team/{id}         { allow read: if true; allow create, update: if isAdmin() && request.resource.data.keys().size() <= 30; allow delete: if isAdmin(); }
    match /tvProject/main/stats/{id}        { allow read: if true; allow create, update: if isAdmin() && request.resource.data.keys().size() <= 30; allow delete: if isAdmin(); }
    match /tvProject/main/pricingPlans/{id} { allow read: if true; allow create, update: if isAdmin() && request.resource.data.keys().size() <= 30; allow delete: if isAdmin(); }
    match /tvProject/main/faqItems/{id}     { allow read: if true; allow create, update: if isAdmin() && request.resource.data.keys().size() <= 30; allow delete: if isAdmin(); }

    /* =================================================================
       কমিউনিটি ক্যাটাগরি — tvProject/main/categories/{slug}
       অ্যাডমিন নতুন ক্যাটাগরি যোগ/নিষ্ক্রিয় করতে পারেন; পোস্ট করতে ক্যাটাগরি active হতে হয়।
       ================================================================= */
    match /tvProject/main/categories/{cid} {
      allow read: if true;

      allow create: if isAdmin() && isSlug(cid)
        && request.resource.data.keys().hasOnly(['name', 'order', 'active', 'createdAt'])
        && request.resource.data.keys().hasAll(['name', 'order', 'active', 'createdAt'])
        && isStr(request.resource.data.name, 1, 40)
        && request.resource.data.order is int && request.resource.data.order >= 0 && request.resource.data.order <= 9999
        && request.resource.data.active is bool
        && request.resource.data.createdAt == request.time;

      allow update: if isAdmin()
        && changed().hasOnly(['name', 'order', 'active'])
        && isStr(request.resource.data.name, 1, 40)
        && request.resource.data.order is int && request.resource.data.order >= 0 && request.resource.data.order <= 9999
        && request.resource.data.active is bool;

      allow delete: if isAdmin();
    }

    /* =================================================================
       আলোচনা — tvProject/main/discussions/{discussionId}
       status: active | hidden | deleted (soft-delete; হার্ড ডিলিট কারো জন্য নয়)
       ================================================================= */
    match /tvProject/main/discussions/{did} {

      allow get: if canReadContent(resource.data);
      // ফিডে পাতা-ভিত্তিক লোড বাধ্যতামূলক: limit ≤ ৫০ (অ্যাডমিনের কাউন্ট/ম্যানেজমেন্ট কোয়েরি বাদে)
      allow list: if (isAdmin() || request.query.limit <= 50) && canReadContent(resource.data);

      allow create: if canPost()
        && request.resource.data.keys().hasOnly(['uid', 'authorName', 'authorAvatar', 'title', 'body', 'category', 'status', 'createdAt', 'updatedAt', 'editedAt', 'likedBy', 'likeCount', 'replyCount'])
        && request.resource.data.keys().hasAll(['uid', 'authorName', 'authorAvatar', 'title', 'body', 'category', 'status', 'createdAt', 'updatedAt', 'editedAt', 'likedBy', 'likeCount', 'replyCount'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.authorName == profile().get('name', '')
        && request.resource.data.authorAvatar == profile().get('avatarThumb', '')
        && isStr(request.resource.data.title, 3, 120)
        && isStr(request.resource.data.body, 3, 5000)
        && isActiveCategory(request.resource.data.category)
        && request.resource.data.status == 'active'
        && request.resource.data.likedBy == []
        && request.resource.data.likeCount == 0
        && request.resource.data.replyCount == 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.editedAt == null;

      allow update: if
        // (১) মালিক নিজের পোস্টের title/body এডিট — editedAt সার্ভার সময়
        (isOwner() && canPost() && resource.data.status == 'active'
          && changed().hasOnly(['title', 'body', 'editedAt', 'updatedAt'])
          && isStr(request.resource.data.title, 3, 120)
          && isStr(request.resource.data.body, 3, 5000)
          && request.resource.data.editedAt == request.time
          && request.resource.data.updatedAt == request.time) ||
        // (২) মালিক নিজের পোস্ট মুছে ফেলা (soft delete)
        (isOwner() && resource.data.status == 'active'
          && changed().hasOnly(['status', 'updatedAt'])
          && request.resource.data.status == 'deleted'
          && request.resource.data.updatedAt == request.time) ||
        // (৩) লাইক/আনলাইক — likeCount সবসময় likedBy.size()-এর সমান
        (canPost() && resource.data.status == 'active'
          && changed().hasOnly(['likedBy', 'likeCount'])
          && isValidLikeToggle(resource.data.likedBy, request.resource.data.likedBy)
          && request.resource.data.likeCount == request.resource.data.likedBy.size()) ||
        // (৪) রিপ্লাই কাউন্ট — একই batch-এ আসল রিপ্লাই লেখা থাকলেই
        (isSignedIn()
          && changed().hasOnly(['replyCount', 'replySyncId'])
          && isValidReplySync(did, resource.data, request.resource.data)) ||
        // (৫) অ্যাডমিন মডারেশন — শুধু status
        (isAdmin()
          && changed().hasOnly(['status', 'updatedAt', 'moderatedBy', 'moderatedAt'])
          && request.resource.data.status in ['active', 'hidden', 'deleted']
          && request.resource.data.moderatedBy == request.auth.uid
          && request.resource.data.moderatedAt == request.time
          && request.resource.data.updatedAt == request.time);

      allow delete: if false;

      /* ---------- রিপ্লাই — discussions/{did}/replies/{rid} ---------- */
      match /replies/{rid} {

        allow get: if (resource.data.status == 'active' && get(discPath(did)).data.status == 'active')
          || (isSignedIn() && resource.data.uid == request.auth.uid)
          || isAdmin();
        allow list: if (isAdmin() || request.query.limit <= 50)
          && ((resource.data.status == 'active' && get(discPath(did)).data.status == 'active')
            || (isSignedIn() && resource.data.uid == request.auth.uid)
            || isAdmin());

        allow create: if canPost()
          && request.resource.data.keys().hasOnly(['uid', 'authorName', 'authorAvatar', 'body', 'replyToId', 'replyToName', 'status', 'createdAt', 'updatedAt', 'editedAt', 'likedBy', 'likeCount'])
          && request.resource.data.keys().hasAll(['uid', 'authorName', 'authorAvatar', 'body', 'status', 'createdAt', 'updatedAt', 'editedAt', 'likedBy', 'likeCount'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.authorName == profile().get('name', '')
          && request.resource.data.authorAvatar == profile().get('avatarThumb', '')
          && isStr(request.resource.data.body, 1, 2000)
          && request.resource.data.status == 'active'
          && request.resource.data.likedBy == []
          && request.resource.data.likeCount == 0
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && request.resource.data.editedAt == null
          && isValidReplyTo(did, request.resource.data)
          && get(discPath(did)).data.status == 'active'
          && parentCountDelta(did, rid, 1);

        allow update: if
          // (১) মালিক নিজের রিপ্লাই এডিট
          (isOwner() && canPost() && resource.data.status == 'active'
            && changed().hasOnly(['body', 'editedAt', 'updatedAt'])
            && isStr(request.resource.data.body, 1, 2000)
            && request.resource.data.editedAt == request.time
            && request.resource.data.updatedAt == request.time) ||
          // (২) মালিক নিজের রিপ্লাই মুছে ফেলা (soft delete) + parent কাউন্ট −১
          (isOwner() && resource.data.status == 'active'
            && changed().hasOnly(['status', 'updatedAt'])
            && request.resource.data.status == 'deleted'
            && request.resource.data.updatedAt == request.time
            && parentCountDelta(did, rid, -1)) ||
          // (৩) লাইক/আনলাইক
          (canPost() && resource.data.status == 'active'
            && get(discPath(did)).data.status == 'active'
            && changed().hasOnly(['likedBy', 'likeCount'])
            && isValidLikeToggle(resource.data.likedBy, request.resource.data.likedBy)
            && request.resource.data.likeCount == request.resource.data.likedBy.size()) ||
          // (৪) অ্যাডমিন মডারেশন
          isAdminReplyModeration(did, rid);

        allow delete: if false;
      }
    }

    /* =================================================================
       রিপোর্ট — tvProject/main/reports/{reporterUid_targetType_targetId}
       ডকুমেন্ট id নির্ধারিত বলে একই ইউজার একই কনটেন্টে দ্বিতীয় রিপোর্ট করতে পারে না
       (দ্বিতীয়বার লেখা = update, আর update শুধু অ্যাডমিনের)।
       ================================================================= */
    match /tvProject/main/reports/{reportId} {
      // রিপোর্টার শুধু নিজের (id যার শুরুতে নিজের uid) ডকুমেন্ট পড়তে পারে — "আগেই রিপোর্ট করেছি কি?" দেখার জন্য
      allow get: if isSignedIn() && (isAdmin() || reportId.matches(request.auth.uid + '_.*'));
      allow list: if isAdmin();

      allow create: if canPost()
        && request.resource.data.keys().hasOnly(['reporterUid', 'targetType', 'targetId', 'discussionId', 'reason', 'details', 'status', 'createdAt'])
        && request.resource.data.keys().hasAll(['reporterUid', 'targetType', 'targetId', 'discussionId', 'reason', 'status', 'createdAt'])
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.targetType in ['discussion', 'reply']
        && isDocId(request.resource.data.targetId)
        && isDocId(request.resource.data.discussionId)
        && reportId == request.auth.uid + '_' + request.resource.data.targetType + '_' + request.resource.data.targetId
        && (
          (request.resource.data.targetType == 'discussion'
            && request.resource.data.discussionId == request.resource.data.targetId
            && exists(discPath(request.resource.data.targetId))) ||
          (request.resource.data.targetType == 'reply'
            && exists(replyPath(request.resource.data.discussionId, request.resource.data.targetId)))
        )
        && request.resource.data.reason in ['spam', 'abuse', 'harassment', 'misinformation', 'inappropriate', 'other']
        && (!('details' in request.resource.data) || isStr(request.resource.data.details, 0, 500))
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time;

      // অ্যাডমিন রিভিউ/রেজল্ভ
      allow update: if isAdmin()
        && changed().hasOnly(['status', 'reviewedBy', 'reviewedAt', 'resolutionNote'])
        && request.resource.data.status in ['open', 'reviewing', 'resolved', 'dismissed']
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewedAt == request.time
        && (!('resolutionNote' in request.resource.data) || isStr(request.resource.data.resolutionNote, 0, 500));

      allow delete: if isAdmin();
    }

    /* =================================================================
       Default deny — উপরে স্পষ্টভাবে অনুমতি না দেওয়া সবকিছু বন্ধ
       ================================================================= */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
