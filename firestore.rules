rules_version = '2';

// Tech Verse — Firestore Security Rules
//
// মডেল:
//  - services / portfolio / caseStudies / testimonials / team / stats / pricingPlans / faqItems
//    → সবাই পড়তে পারবে (পাবলিক সাইট), শুধু অ্যাডমিন লিখতে পারবে (অ্যাডমিন প্যানেল)।
//  - settings/site → সাইটের হিরো টেক্সট, WhatsApp নম্বর ইত্যাদি — সবাই পড়তে পারবে, শুধু অ্যাডমিন লিখতে পারবে।
//  - users/{uid} → নিজের ডকুমেন্ট নিজে পড়তে/লিখতে পারবে (name/phone/photoURL শুধু), role ফিল্ড
//    শুধু অ্যাডমিন বদলাতে পারবে — এভাবে কেউ নিজেকে নিজে অ্যাডমিন বানাতে পারবে না।
//  - bookings/{id} → যে কেউ (লগইন ছাড়াও) নতুন বুকিং তৈরি করতে পারবে, নিজের বুকিং নিজে পড়তে
//    পারবে, কিন্তু স্ট্যাটাস বদলানো/মোছা শুধু অ্যাডমিন পারবে।
//
// প্রথম অ্যাডমিন সেট করার জন্য একবার Firebase Console থেকে ম্যানুয়ালি নিজের users/{uid}
// ডকুমেন্টে role: "admin" (স্ট্রিং) ফিল্ড যোগ করতে হবে — README দেখুন।

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ---------------- Users ----------------
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());

      // সাইন-আপের সময় নিজের ডকুমেন্ট নিজে তৈরি করে (role ছাড়া — self-admin ঠেকাতে)
      allow create: if isSignedIn() && request.auth.uid == userId &&
        !('role' in request.resource.data);

      // নিজের প্রোফাইল ফর্ম শুধু name/phone/photoURL বদলাতে পারবে; role শুধু অ্যাডমিন বদলাতে পারবে
      allow update: if isAdmin() ||
        (isSignedIn() && request.auth.uid == userId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phone', 'photoURL']));

      allow delete: if isAdmin();
    }

    // ---------------- Bookings ----------------
    match /bookings/{bookingId} {
      allow create: if true; // পাবলিক বুকিং ফর্ম — লগইন ছাড়াও জমা দেওয়া যায়
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // ---------------- Site settings ----------------
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------------- পাবলিক কন্টেন্ট কালেকশন ----------------
    match /services/{id} { allow read: if true; allow write: if isAdmin(); }
    match /portfolio/{id} { allow read: if true; allow write: if isAdmin(); }
    match /caseStudies/{id} { allow read: if true; allow write: if isAdmin(); }
    match /testimonials/{id} { allow read: if true; allow write: if isAdmin(); }
    match /team/{id} { allow read: if true; allow write: if isAdmin(); }
    match /stats/{id} { allow read: if true; allow write: if isAdmin(); }
    match /pricingPlans/{id} { allow read: if true; allow write: if isAdmin(); }
    match /faqItems/{id} { allow read: if true; allow write: if isAdmin(); }
  }
}
